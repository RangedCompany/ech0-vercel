{
  "name": "Ech0",
  "short_name": "Ech0",
  "lang": "fr-FR",
  "dir": "ltr",
  "categories": ["social", "news"],
  "description": "Ech0 est un microblog libre, léger et auto-hébergé. Publiez vos idées, vos notes et vos liens depuis une interface simple ou la ligne de commande. Vous gardez le contrôle de vos données.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f1ec",
  "theme_color": "#f4f1ec",
